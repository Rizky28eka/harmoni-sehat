{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.js",
    ".eslintrc.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/public",
    "src/tests",
    "jest.config.ts" // Exclude jest.config.ts from main compilation
  ]
}