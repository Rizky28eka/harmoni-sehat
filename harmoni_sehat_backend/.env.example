# ===== Server =====
NODE_ENV=development
PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=*            # comma separated list in production, e.g. https://app.example.com

# ===== Database =====
MONGO_URI=mongodb://localhost:27017/harmoni_sehat

# ===== Auth (REQUIRED: the server refuses to start without JWT_SECRET) =====
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30

# ===== AI (Gemini) =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ===== Email (password reset) =====
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM="Harmoni Sehat <no-reply@example.com>"
FRONTEND_URL=http://localhost:3000

# ===== Payments (Midtrans). Leave empty to use the built-in sandbox simulator =====
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# ===== Push notifications (Firebase). Path to a service-account JSON; empty = disabled =====
FCM_SERVICE_ACCOUNT_PATH=

# ===== Uploads: STORAGE_DRIVER = local | cloudinary | s3 (auto-detected from the credentials below) =====
STORAGE_DRIVER=
UPLOAD_DIR=uploads
# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# S3 or S3-compatible (Cloudflare R2, MinIO). Make objects publicly readable or put a CDN in front (S3_PUBLIC_URL).
S3_BUCKET=
S3_REGION=ap-southeast-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ===== WebRTC (in-app calls). STUN works for most networks; add TURN for strict NATs/cellular =====
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=                # e.g. turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_SECRET=              # coturn static-auth-secret; the API mints short-lived credentials from it

# ===== API docs (Swagger UI at /api/docs). Always on outside production =====
DOCS_ENABLED=false

# ===== Optional =====
REDIS_URL=
ENCRYPTION_KEY=           # enables AES-256-GCM encryption of sensitive medical fields
