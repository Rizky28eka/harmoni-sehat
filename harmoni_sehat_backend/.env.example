# ===== Server =====
NODE_ENV=development
PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=*            # comma separated list in production, e.g. https://app.example.com

# ===== Database =====
MONGO_URI=mongodb://localhost:27017/harmoni_sehat

# ===== Auth (REQUIRED: the server refuses to start without JWT_SECRET) =====
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30

# ===== AI (Gemini) =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ===== Email (password reset) =====
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM="Harmoni Sehat <no-reply@example.com>"
FRONTEND_URL=http://localhost:3000

# ===== Payments (Midtrans). Leave empty to use the built-in sandbox simulator =====
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# ===== Push notifications (Firebase). Path to a service-account JSON; empty = disabled =====
FCM_SERVICE_ACCOUNT_PATH=

# ===== Uploads =====
UPLOAD_DIR=uploads

# ===== Optional =====
REDIS_URL=
ENCRYPTION_KEY=           # enables AES-256-GCM encryption of sensitive medical fields
