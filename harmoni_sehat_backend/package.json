{
  "name": "harmoni-sehat-backend",
  "version": "1.0.0",
  "description": "Comprehensive backend API for Harmoni Sehat - Indonesian health management application with appointment booking, patient records, and telemedicine features",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon --watch src --exec \"ts-node src/server.ts\"",
    "dev:debug": "nodemon --inspect dist/server.js",
    "migrate": "ts-node src/scripts/migrate.ts",
    "migrate:rollback": "ts-node src/scripts/migrate.ts --rollback",
    "seed": "ts-node src/scripts/seed.ts",
    "seed-mongo": "ts-node src/scripts/seedMongo.ts",
    "seed:dev": "NODE_ENV=development ts-node src/scripts/seed.ts",
    "seed:prod": "NODE_ENV=production ts-node src/scripts/seed.ts",
    "build": "npm run lint && npm run test",
    "test": "NODE_ENV=test MONGO_URI_TEST=$MONGO_URI_TEST jest --coverage --config jest.config.ts",
    "test:watch": "jest --watch",
    "test:integration": "jest --testPathPattern=integration",
    "lint": "eslint . --ext .js,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rimraf node_modules package-lock.json",
    "security:audit": "npm audit --audit-level moderate",
    "security:fix": "npm audit fix",
    "docs": "jsdoc -c jsdoc.config.json",
    "backup:db": "node scripts/backup-db.js",
    "restore:db": "node scripts/restore-db.js",
    "health:check": "node scripts/health-check.js",
    "logs:clean": "node scripts/clean-logs.js",
    "pre-commit": "lint-staged",
    "prepare": "husky install"
  },
  "keywords": [
    "healthcare",
    "telemedicine",
    "appointment-booking",
    "patient-management",
    "medical-records",
    "indonesia",
    "health-app",
    "nodejs",
    "express",
    "mongodb",
    "rest-api",
    "sms-notification",
    "twilio"
  ],
  "author": {
    "name": "Harmoni Sehat Team",
    "email": "developer@harmonisehat.com",
    "url": "https://harmonisehat.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/harmonisehat/backend.git"
  },
  "bugs": {
    "url": "https://github.com/harmonisehat/backend/issues"
  },
  "homepage": "https://harmonisehat.com",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.18.1",
    "express-validator": "^7.2.1",
    "google-auth-library": "^10.1.0",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.4",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.1",
    "twilio": "^5.7.2",
    "winston": "^3.15.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.2",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.16.0",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/supertest": "^6.0.3",
    "@types/winston": "^2.4.4",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jsdoc": "^4.0.4",
    "lint-staged": "^15.2.10",
    "nodemon": "^3.1.10",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "**/*.js",
      "!node_modules/**",
      "!coverage/**",
      "!scripts/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "nodemonConfig": {
    "ignore": [
      "test/*",
      "docs/*",
      "coverage/*",
      "uploads/*"
    ],
    "env": {
      "NODE_ENV": "development"
    }
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "6.0.0"
    }
  }
}
